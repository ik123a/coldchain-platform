# ColdChain Rescue - backend environment template
#
# Copy to `backend/.env` and fill in real values. `backend/.env` is gitignored
# and must never be committed.
#
#     cp backend/.env.example backend/.env
#
# Only DATABASE_URL and JWT_SECRET are required to boot. Every other variable
# is optional: the Gemini integration is a separate, optional service and the
# deterministic decision agents run with no key at all.
#
# NOTE ON DEFAULTS: code reads these with `os.getenv(NAME, "")` or an empty
# fallback. No credential has a real value baked in as a default. If a required
# credential is missing the app refuses to start rather than falling back to a
# well-known value.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Database. SQLite needs no server; Postgres needs a real DSN.
DATABASE_URL=sqlite+aiosqlite:///./coldchain.db

# JWT signing key for auth tokens. MUST be a strong random string in any
# non-development environment. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# The app REFUSES to start outside development if this is unset or equals the
# old well-known placeholder "***REDACTED-JWT-PLACEHOLDER***" — with a shared
# signing key every issued token would be forgeable.
#
# In development you may omit it entirely: a random per-process secret is
# generated automatically (tokens then stop validating after a restart, which
# is fine locally).
JWT_SECRET=replace-with-48-plus-random-characters-here

# ---------------------------------------------------------------------------
# Optional - Gemini / Google AI integration
# ---------------------------------------------------------------------------
# None of these are needed for the deterministic agents, the fleet simulation,
# or any core feature. They only power the optional image/video/critique
# helpers under app/services/gemini/.
#
# Obtain a key at https://aistudio.google.com/apikey

GEMINI_API_KEY=
# Optional second key, used when the first is rate-limited or unavailable.
GEMINI_API_KEY_BACKUP=
# Optional alias. If set it is used where the code reads GOOGLE_API_KEY.
GOOGLE_API_KEY=

# Model names. These are NOT secrets; the values below are the current defaults.
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_TEXT_MODEL=gemini-3.8-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_PREMIUM_IMAGE_MODEL=gemini-3-pro-image
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# ---------------------------------------------------------------------------
# Optional - LLM-backed agents (not used in the shipped deterministic path)
# ---------------------------------------------------------------------------
# Leaving these empty keeps the decision path fully deterministic, which is what
# the project claims and what the reproducible demo depends on.
OPENAI_API_KEY=
MODEL_NAME=

# ---------------------------------------------------------------------------
# Optional - runtime
# ---------------------------------------------------------------------------

# Comma-separated allowed origins for the API.
CORS_ORIGINS=http://localhost:3000

# Bind address for the backend. Use 0.0.0.0 only to reach it from another
# device on the LAN, and only on a trusted network: operational routes are not
# protected by the auth endpoints.
# API_HOST=127.0.0.1

# Simulation settings.
# FLEET_AUTOSTART=1
# SIM_MIN_PER_WALL_SEC_AT_1X=0.5
